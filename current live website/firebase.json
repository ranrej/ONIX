{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/service",
        "destination": "/service.html",
        "type": 301
      },
      {
        "source": "/about",
        "destination": "/about.html",
        "type": 301
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
